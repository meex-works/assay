# assay keys. Copy this file to .env (same folder) and fill in what your enabled modules need.
#   cp .env.example .env
# .env is git-ignored: it never leaves your machine. `npm run doctor` tells you what's missing.
# Each key is only needed if the module that uses it is on in config/assay.yaml.

# ── Yellowstone gRPC: every pump.fun transaction (feeds.grpc) ──────────────────────────────────────────────────────
# The endpoint goes in config/assay.yaml (providers.grpc_endpoint); the token goes here.
# Alchemy: the token is your Alchemy API key (set ALCHEMY_API_KEY below and leave this empty).
GRPC_TOKEN=

# ── Solana RPC: funding lookups and quote-coin names (funding) ─────────────────────────────────────────────────────
# Either a full URL from any provider…
RPC_URL=
# …or just an Alchemy API key, which also serves as the gRPC token above.
ALCHEMY_API_KEY=

# ── Websocket: a second, independent feed of launches (feeds.websocket) ────────────────────────────────────────────
# Either a full wss:// URL from any provider…
WEBSOCKET_URL=
# …or a Helius API key (the free plan is enough).
HELIUS_API_KEY=

# ── Telegram: posting to your channel (post.telegram) ──────────────────────────────────────────────────────────────
# From @BotFather. The bot must be an admin of your channel (post + edit) and of its discussion group.
TELEGRAM_BOT_TOKEN=

# ── Front end: the key the site's Worker sends to the API (only if you run src/api.ts) ─────────────────────────────
# Any long random string: openssl rand -hex 24
ASSAY_API_KEY=

# ── Settings can live here too ─────────────────────────────────────────────────────────────────────────────────────
# Any config/assay.yaml value, as ASSAY_<SECTION>_<KEY>. For example:
# ASSAY_POST_DRY=true
# ASSAY_FEEDS_WEBSOCKET=false
# ASSAY_CHECKS_LINKS=false
