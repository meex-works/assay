# assay ships with no keys. Whoever runs an instance supplies their own.
# A missing key switches its signals off and lowers confidence; it never fails the run.

# Solana: required
SOLANA_RPC_URL=
# one of these for the launch stream
SOLANA_GRPC_URL=
SOLANA_GRPC_TOKEN=
SOLANA_WS_URL=
# address webhooks from your RPC provider (creator wallets, fee vaults, clusters)
SOLANA_WEBHOOK_SECRET=
WEBHOOK_PUBLIC_URL=

# X (first-party API), optional: identity checks and X's capped share of Mindshare
X_BEARER_TOKEN=

# Models: classification, extraction, the L4 review agent
MODEL_API_KEY=
MODEL_FAST=
MODEL_REVIEW=

# Coverage
NEWS_API_KEY=

# Optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
NEYNAR_API_KEY=

# Infrastructure
NATS_URL=nats://localhost:4222
DATABASE_URL=postgres://localhost/assay
CAPTURE_BUCKET_URL=
